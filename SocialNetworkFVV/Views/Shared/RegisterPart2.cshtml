@model SocialNetworkFVV.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}
<div class="Register2">
    <div>
        <h2>Регистрация нового пользователя</h2>
        <form method="post" asp-controller="Register" asp-action="Register">
            <div asp-validation-summary="ModelOnly"></div>
            <div>
                <label asp-for="FirstName"></label><br />
                <input asp-for="FirstName" class="ipt HomeControlInput" />
                <span asp-validation-for="FirstName"></span>
            </div>
            <div>
                <label asp-for="LastName"></label><br />
                <input asp-for="LastName" class="ipt HomeControlInput" />
                <span asp-validation-for="LastName"></span>
            </div>
            <div>
                <label asp-for="Login"></label><br />
                <input asp-for="Login" class="ipt HomeControlInput" />
                <span asp-validation-for="Login"></span>
            </div>
            <div>
                <label asp-for="EmailReg"></label><br />
                <input asp-for="EmailReg" class="ipt HomeControlInput" />
                <span asp-validation-for="EmailReg"></span>
            </div>
            <div>
                <label asp-for="BirthdayDate"></label><br />
                <input asp-for="BirthdayDate" class="ipt HomeControlInput" />
                <span asp-validation-for="BirthdayDate"></span>
            </div>
            <div>
                <label asp-for="PasswordReg"></label><br />
                <input asp-for="PasswordReg" class="ipt HomeControlInput" />
                <span asp-validation-for="PasswordReg"></span>
            </div>
            <div>
                <label asp-for="PasswordConfirm"></label><br />
                <input asp-for="PasswordConfirm" class="ipt HomeControlInput" />
                <span asp-validation-for="PasswordConfirm"></span>
            </div>
            <div>
                <input type="submit" value="Регистрация" class="btn"/>
            </div>
        </form>
    </div>
</div>
