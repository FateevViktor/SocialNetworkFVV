@using Microsoft.AspNetCore.Identity;
@using SocialNetworkFVV.Models;
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

@if (SignInManager.IsSignedIn(User))
{	
	<form method="post" asp-controller="AccountManager" asp-action="Logout">
		<span>@User.Identity.Name       </span>
		<a asp-area="" asp-controller="AccountManager" asp-action="MyPage">Мой профиль</a>
		<input class="btnInvers" type="submit" value="Выход" />
	</form>
}
