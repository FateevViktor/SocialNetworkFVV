@using Microsoft.AspNetCore.Identity;
@using SocialNetworkFVV.Models;
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

@model SocialNetworkFVV.ViewModels.LoginViewModel


@{
    ViewData["Title"] = "Login";
}

@if (SignInManager.IsSignedIn(User) == false)
{
    <!--<div class="block-reg background-white">-->
    <div class="BlockLogin">
        <h4 class="center">Добро пожаловать!</h4>
        <form class="frm" method="post" asp-controller="AccountManager" asp-action="Login">
            <div asp-validation-summary="ModelOnly"></div>
            <div>
                <div class="mrgn">
                    <label asp-for="Login"></label><br />
                    <input asp-for="Login" class="ipt HomeControlInput" />
                    <span asp-validation-for="Login" class="text-danger"></span>
                </div>
            </div>
            <div>
                <div class="mrgn">
                    <label asp-for="Password"></label><br />
                    <input asp-for="Password" class="ipt HomeControlInput" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
            </div>
            <div>
                <div class="mrgn">
                    <label asp-for="RememberMe"></label><br />
                    <input asp-for="RememberMe" class="ipt HomeControlInput" />
                </div>
            </div>
            <div class="mrgn">
                <input class="btn HomeControlButton" type="submit" value="Войти" />
            </div>
        </form>
    </div>
}

